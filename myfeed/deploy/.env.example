# myfeed 生产编排的变量（给 docker-compose.prod.yml 用）。
#
#     cp deploy/.env.example deploy/.env
#     # 然后按下面把每个值改掉 —— **不要直接用这里的占位值**
#
# deploy/.env 被 .gitignore 排除，**不进仓库**。
#
# ---------- ⚠ 这个文件里的值有一半是重复的 ----------
#
# mysql / redis / rabbitmq 的密码同时存在于两个地方：
#
#   ① 这个文件            → 给**容器本身**用（mysql 容器拿它当 root 密码）
#   ② configs/config.prod.yaml → 给 **Go 进程**用（config.Load 只读 yaml，
#                                它不做环境变量替换，所以只能写死在里面）
#
# 改密码 = 改两处。漏改一处的表现**不都是报错**：
#
#   mysql 密码只改一处 → api 连不上库 → log.Fatalf → 容器反复重启（这个会报）
#   redis 密码只改一处 → **静默降级**：日志里一行"Redis 不可用（缓存禁用）"，
#                        服务照常启动、功能一条不缺、只是缓存全没了
#   rabbitmq 同理      → "MQ 降级为同步直写"，也是静默的
#
# 所以部署后**必须看一眼启动日志**确认那两个"已连接"（见验证步骤）。
# 这正是本项目一贯的坑：最贵的失败是没报错的那种。
#
# ---------- ⚠ 密码里不要有空格 ----------
#
# compose 会把下面这些值直接代进 compose 文件里，而 redis 那条
# `command:` 是字符串形式（compose 按空白切词）。带空格的密码会把
# 命令行切成两半，报错信息完全指不到密码上。
# 用字母数字 + 少数符号（- _ = + /）最省事。

# ---------- MySQL ----------
# 这是 root 密码。虽然 mysql 端口不对公网发布，也别留 123456：
# 内网横向 + 弱密码是同一个事故的两半。
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_pw

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_redis_pw

# ---------- RabbitMQ ----------
# 管理界面（127.0.0.1:15672，SSH 隧道进）用这组账号登录。
# ⚠ 不要用 admin / password123（开发期的值）。
RABBITMQ_USER=myfeed
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_pw

# ---------- JWT 签名密钥 ----------
#
# **本次上云最关键的一个值**。auth/jwt.go:20-23 在这个变量为空时回落到
# 硬编码的 "myfeed-dev-secret-change-me"，**并且不打印任何警告**。
# 有了公网 IP 之后，任何知道这个字符串的人都能给任意账号签发 token ——
# 等于全站账号随便登。
#
# 生成一个（随便挑一条能跑的）：
#     openssl rand -base64 48
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#     docker run --rm alpine/openssl rand -base64 48
#
# ⚠ 换掉这个值会让**所有已签发的 token 立刻失效**（所有人被登出）。
#   这是预期行为，但要挑个没人在线的时候做。
JWT_SECRET=CHANGE_ME_generate_a_long_random_string

# ---------- 对外端口 ----------
#
# 服务器上留空 = 80（就是它要跑的值）。
# 本机验证时如果 80 被占用（Windows 上常被 IIS / 其它服务占），
# 在这里写 8080 之类，然后浏览器开 http://localhost:8080。
# **上服务器前记得改回 80 或删掉这一行。**
WEB_PORT=80
